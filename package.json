{
  "name": "@mr-hope/verify-commit-message",
  "version": "0.1.0",
  "description": "Verify conventional commit messages with actionable, agent-friendly error reports.",
  "keywords": [
    "commit",
    "commit-msg",
    "commitlint",
    "conventional-commits",
    "git",
    "husky",
    "verify"
  ],
  "homepage": "https://github.com/Mister-Hope/verify-commit-message",
  "bugs": "https://github.com/Mister-Hope/verify-commit-message/issues",
  "license": "MIT",
  "author": {
    "name": "Mister-Hope",
    "email": "mister-hope@outlook.com",
    "url": "https://mister-hope.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mister-Hope/verify-commit-message.git"
  },
  "bin": {
    "verify-commit-message": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf ./dist",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint --deny-warnings && oxfmt --check",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@mr-hope/tsconfig": "0.0.4",
    "@types/node": "24.19.0",
    "@vitest/coverage-istanbul": "5.0.2",
    "oxc-config-hope": "0.3.14",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "publint": "0.3.24",
    "rimraf": "6.1.3",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.7.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.23.0 || ^24.21.0 || ^26.10.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
